# Sentinel Twin v2 — Environment Variables
# Copy this file to .env and fill in your keys.
# The system works perfectly without any keys (falls back to local AI).

# ── Google Gemini API Key ─────────────────────────────────────────
# Get a free key at: https://aistudio.google.com/app/apikey
# Leave blank to use offline template fallback.
GEMINI_API_KEY=

# ── Groq API Key (optional second-choice cloud) ───────────────────
# Get a free key at: https://console.groq.com/
# Only used if GEMINI_API_KEY is empty.
GROQ_API_KEY=

# ── Roboflow AI Vision API Key ─────────────────────────────────────
# Workspace: ankit-chaudhary
# Workflow: fire-smoke-and-human-detector-logic
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# ── Serial Port (for --serial mode) ──────────────────────────────
# Windows: COM3, COM4, etc.  Linux/Mac: /dev/ttyUSB0, /dev/ttyACM0
SENTINEL_PORT=COM3

# ── Input Mode ────────────────────────────────────────────────────
# 'sim' = software simulator (default), 'serial' = real ESP32
SENTINEL_MODE=sim

